{
  "name": "cfb-tv-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "resolve-channels": "node scripts/resolve-channels.mjs",
    "test:matcher": "node scripts/test-matcher.mjs",
    "test:relevance": "node scripts/test-relevance.mjs",
    "test:nfl": "node scripts/test-nfl.mjs",
    "test": "npm run test:matcher && npm run test:relevance && npm run test:nfl && npm run test:plausible && npm run test:sha256",
    "test:plausible": "node scripts/test-plausible.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "npm run build && npm run build:server && node server.mjs",
    "serve": "node server.mjs",
    "test:sha256": "node scripts/test-sha256.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
