# YouTube Data API v3 key. Server-side only — never prefixed with VITE_, never
# shipped to the browser. See README.md "Getting a YouTube API key".
YOUTUBE_API_KEY=

# Highlightly API key, from the DIRECT platform at highlightly.net (not
# RapidAPI — the two use different auth headers and are not interchangeable).
# Server-side only; never prefixed with VITE_.
HIGHLIGHTLY_API_KEY=

# Set to 1 to serve fixture data from /fixtures instead of calling ESPN/YouTube.
# Lets you build the UI on a Tuesday in July.
MOCK=0
